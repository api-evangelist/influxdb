            "headers": [
              {
                "name": "Zap-Trace-Span",
                "value": "[object Object]"
              }
            ],
            "params": [
              {
                "name": "dashboardID",
                "value": "",
                "type": "path",
                "description": "The ID of the dashboard to delete."
              },
              {
                "name": "cellID",
                "value": "",
                "type": "path",
                "description": "The ID of the cell to delete."
              }
            ]
          },
          "docs": "Delete a dashboard cell"
        },
        {
          "info": {
            "name": "Retrieve the view for a cell",
